{
  "name": "recepty",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "validate": "tsx scripts/validate-recipes.ts",
    "check": "astro check",
    "test": "tsx --test tests/*.test.ts",
    "build": "npm run validate && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "verify": "npm run check && npm test && npm run build",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "astro": "7.3.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}

---
import '../styles/global.css';
import { withBase } from '../lib/urls';
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Recepty — místo pro dobré jídlo',
  description = 'Osobní kuchařka. Recepty, ke kterým se rádi vracíme.',
} = Astro.props;
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f6f0" />
    <title>{title}</title>
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
  </head>
  <body>
    <a href="#main" class="skip-link">
      Přejít na obsah
    </a>
    <header class="site-header shell">
      <a class="brand" href={withBase()} aria-label="Recepty – úvodní stránka">
        <span class="brand-symbol" aria-hidden="true">
          r.
        </span>
        <span>
          recepty<span class="brand-dot">.</span>
        </span>
      </a>
      <span class="header-note">MALÁ OSOBNÍ KUCHAŘKA</span>
      <a class="header-link" href={withBase()}>
        Všechny recepty <span aria-hidden="true">↗</span>
      </a>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer shell">
      <a class="footer-brand" href={withBase()}>
        recepty.
      </a>
    </footer>
  </body>
</html>

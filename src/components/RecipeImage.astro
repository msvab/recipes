---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Recipe } from '../lib/recipes/schema';
interface Props {
  image: Recipe['image'];
  category?: string;
  eager?: boolean;
}
const { image, category = 'Z domácí kuchyně', eager = false } = Astro.props;
const assets = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/recipes/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const asset =
  image.kind !== 'placeholder'
    ? assets[`/src/assets/recipes/${image.file}`]?.default
    : undefined;
if (image.kind !== 'placeholder' && !asset)
  throw new Error(`Image not found: ${image.file}`);
---

<div
  class:list={[
    'recipe-image',
    { 'is-placeholder': image.kind === 'placeholder' },
  ]}
>
  {asset && image.kind !== 'placeholder' ? (
    <Image
      src={asset}
      alt={image.alt}
      widths={[400, 800, 1200]}
      sizes="(max-width: 640px) 100vw, 50vw"
      loading={eager ? 'eager' : 'lazy'}
      format="webp"
    />
  ) : (
    <div class="placeholder-art" aria-hidden="true">
      <span class="art-label">{category}</span>
      <svg viewBox="0 0 400 240" fill="none">
        <ellipse
          cx="205"
          cy="211"
          rx="91"
          ry="8"
          fill="currentColor"
          opacity=".06"
        />
        <circle
          cx="201"
          cy="120"
          r="82"
          stroke="currentColor"
          stroke-width="1.5"
        />
        <circle cx="201" cy="120" r="65" stroke="currentColor" opacity=".45" />
        <path
          d="M89 63v113m-9-113v35q9 16 18 0V63m210 0v113m0-113q-22 34 0 57"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        />
        <path
          d="M181 150q11-41 43-67m-31 50q-25-3-22-24 23 0 22 24zm11-16q-1-23 23-24 0 23-23 24zm-20 30q21 9 31-13-22-9-31 13z"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linejoin="round"
        />
      </svg>
      <span class="photo-pending">Místo pro fotografii</span>
    </div>
  )}
  {image.kind === 'ai' && (
    <span class="image-ai-label">Ilustrační obrázek vytvořený AI</span>
  )}
</div>
